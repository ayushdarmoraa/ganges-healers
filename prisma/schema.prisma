generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  image              String?
  phone              String?             @unique
  password           String?
  role               Role                @default(USER)
  vip                Boolean             @default(false)
  freeSessionCredits Int                 @default(0)
  emailVerified      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  activityLogs       ActivityLog[]
  bookings           Booking[]           @relation("UserBookings")
  communityAccess    CommunityAccess[]
  communityComments  CommunityComment[]
  communityLikes     CommunityLike[]
  communityPosts     CommunityPost[]
  deletedPosts       CommunityPost[]     @relation("PostDeletedBy")
  deletedComments    CommunityComment[]  @relation("CommentDeletedBy")
  reportsFiled       CommunityReport[]   @relation("ReportAuthor")
  reportsReviewed    CommunityReport[]   @relation("ReportReviewer")
  courseEnrollments  CourseEnrollment[]
  healer             Healer?
  notifications      Notification[]
  orders             Order[]
  payments           Payment[]
  programEnrollments ProgramEnrollment[]
  sessions           Session[]
  sessionCredits     SessionCredit[]
  memberships        VIPMembership[]
  reviews            Review[]
  firstSource        String?
  firstVariant       String?
}

model Healer {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  bio                String?
  experienceYears    Int                      @default(0)
  rating             Float                    @default(0)
  certifications     Json?
  availability       Json?
  specializations    String[]                 @default([])
  isActive           Boolean                  @default(true)
  isVerified         Boolean                  @default(false)
  searchVector       Unsupported("tsvector")?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  bookings           Booking[]
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programEnrollments ProgramEnrollment[]
  reviews            Review[]
}

model Service {
  id           String                   @id @default(cuid())
  name         String
  slug         String                   @unique
  description  String
  tagline      String?
  category     String
  price        Float
  duration     Int
  image        String?
  mode         ServiceMode              @default(BOTH)
  benefits     Json?
  isActive     Boolean                  @default(true)
  popularity   Int                      @default(0)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  bookings     Booking[]
  products     Product[]
  reviews      Review[]
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  healerId    String
  serviceId   String
  scheduledAt DateTime
  durationMin Int
  status      BookingStatus @default(PENDING)
  pricePaise  Int
  meetingLink String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  healer      Healer        @relation(fields: [healerId], references: [id], onDelete: Cascade)
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user        User          @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?
  review      Review?

  @@index([userId, scheduledAt(sort: Desc)])
  @@index([healerId, scheduledAt, status])
  @@index([scheduledAt])
  @@index([userId, scheduledAt(sort: Desc)], map: "Booking_userId_scheduledAt_desc_idx")
}

model Payment {
  id               String         @id @default(cuid())
  bookingId        String?        @unique
  userId           String?
  gateway          String
  orderId          String?
  paymentId        String?
  status           String
  amountPaise      Int
  createdAt        DateTime       @default(now())
  type             PaymentType?
  statusEnum       PaymentStatus?
  currency         String?        @default("INR")
  gatewayOrderId   String?        @unique
  gatewayPaymentId String?        @unique
  gatewaySignature String?
  metadata         Json?
  invoice          Invoice?
  booking          Booking?       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds          Refund[]

  @@index([statusEnum])
  @@index([type])
  @@index([userId])
}

model Refund {
  id              String   @id @default(cuid())
  paymentId       String
  amountPaise     Int
  reason          String?
  gatewayRefundId String?  @unique
  status          String?
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Invoice {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  invoiceNumber String   @unique
  issuedAt      DateTime @default(now())
  billTo        Json
  lineItems     Json
  subtotalPaise Int
  taxPaise      Int      @default(0)
  totalPaise    Int
  pdfUrl        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Program {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  title           String
  description     String
  pricePaise      Int
  totalSessions   Int
  sessionsPerWeek Int
  durationMinutes Int
  isActive        Boolean                  @default(true)
  searchVector    Unsupported("tsvector")?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  enrollments     ProgramEnrollment[]

  @@index([isActive])
}

model ProgramEnrollment {
  id        String                  @id @default(cuid())
  userId    String
  programId String
  pricePaise Int?
  healerId  String?
  status    ProgramEnrollmentStatus @default(pending_payment)
  schedule  Json?
  progress  Json?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  healer    Healer?                 @relation(fields: [healerId], references: [id])
  program   Program                 @relation(fields: [programId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([programId])
  @@index([healerId])
}

model MembershipPlan {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  pricePaise     Int
  interval       MembershipInterval
  razorpayPlanId String             @unique
  isActive       Boolean            @default(true)
  benefits       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    VIPMembership[]

  @@index([isActive])
}

model VIPMembership {
  id             String           @id @default(cuid())
  userId         String
  planId         String
  subscriptionId String           @unique
  status         MembershipStatus @default(pending)
  startDate      DateTime?
  endDate        DateTime?
  nextBillingAt  DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessionCredits SessionCredit[]
  plan           MembershipPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([planId])
}

model SessionCredit {
  id           String         @id @default(cuid())
  userId       String
  membershipId String?
  credits      Int
  expiresAt    DateTime?
  source       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  membership   VIPMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([membershipId])
}

model CommunityAccess {
  id        String   @id @default(cuid())
  userId    String
  level     String
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level])
}

model CommunityTopic {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  posts       CommunityPost[]

  @@index([isActive, order])
}

model CommunityTag {
  id        String             @id @default(cuid())
  slug      String             @unique
  name      String
  createdAt DateTime           @default(now())
  posts     CommunityPostTag[]
}

model CommunityPostTag {
  postId String
  tagId  String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    CommunityTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model CommunityPost {
  id           String                   @id @default(cuid())
  userId       String
  topicId      String?
  title        String
  content      String
  isPinned     Boolean                  @default(false)
  deletedAt    DateTime?
  deletedById  String?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  comments     CommunityComment[]
  likes        CommunityLike[]
  tags         CommunityPostTag[]
  deletedBy    User?                    @relation("PostDeletedBy", fields: [deletedById], references: [id])
  topic        CommunityTopic?          @relation(fields: [topicId], references: [id])
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([topicId])
  @@index([isPinned])
  @@index([deletedAt])
}

model CommunityComment {
  id          String        @id @default(cuid())
  postId      String
  userId      String
  content     String
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedBy   User?         @relation("CommentDeletedBy", fields: [deletedById], references: [id])
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@index([deletedAt])
}

model CommunityLike {
  id     String        @id @default(cuid())
  postId String
  userId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model CommunityReport {
  id          String   @id @default(cuid())
  userId      String
  targetType  String   // 'post' | 'comment'
  targetId    String
  reason      String
  status      String   @default("pending") // 'pending' | 'reviewed' | 'dismissed'
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  reviewer    User?    @relation("ReportReviewer", fields: [reviewedBy], references: [id])
  user        User     @relation("ReportAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, targetId])
  @@index([userId])
}

model Course {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  title        String
  description  String
  pricePaise   Int
  imageUrl     String?
  isActive     Boolean                  @default(true)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  enrollments  CourseEnrollment[]
  lessons      CourseLesson[]

  @@index([isActive])
}

model CourseLesson {
  id       String  @id @default(cuid())
  courseId String
  title    String
  videoUrl String?
  content  String?
  order    Int
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, order])
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  pricePaise Int?
  status    String   @default("pending_payment")
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status])
}

model AudioTrack {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  title        String
  description  String?
  category     String
  audioUrl     String
  duration     Int
  isPremium    Boolean                  @default(false)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())

  @@index([category])
  @@index([isPremium])
}

model BlogPost {
  id           String                   @id @default(cuid())
  slug         String                   @unique
  title        String
  content      String
  excerpt      String?
  imageUrl     String?
  published    Boolean                  @default(true)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([published, createdAt(sort: Desc)])
}

model ProductCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  title            String
  shortDescription String                   @default("")
  longDescription  String                   @default("")
  pricePaise       Int
  imageUrl         String?
  gallery          Json?
  ratingAvg        Float?
  stockStatus        String                   @default("IN_STOCK")
  stockCount         Int?
  chakra             String?
  spiritualBenefits  Json?
  ritualUse          Json?
  consecrationStory  String?                  @db.Text
  isConsecrated      Boolean                  @default(false)
  categoryId         String?
  serviceId        String?
  isActive         Boolean                  @default(true)
  searchVector     Unsupported("tsvector")?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  orderItems       OrderItem[]
  bundleItems      BundleItem[]
  category         ProductCategory?         @relation(fields: [categoryId], references: [id])
  service          Service?                 @relation(fields: [serviceId], references: [id])

  @@index([isActive])
  @@index([categoryId])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  status            String      @default("pending_payment")
  totalPaise        Int
  paymentId         String?     @unique
  shippingAddress   Json?
  source            String?
  chakra            String?
  intention         String?
  experimentVariant String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]

  @@index([userId, createdAt(sort: Desc)])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  pricePaise Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AbandonedCart {
  id                   String    @id @default(cuid())
  userId               String?
  email                String?
  phone                String?
  items                Json
  source               String?
  chakra               String?
  intention            String?
  whatsappSentAt       DateTime?
  emailSentAt          DateTime?
  finalReminderSentAt  DateTime?
  recoveredAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([whatsappSentAt, recoveredAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
}

model OptimizationLog {
  id        String   @id @default(cuid())
  action    String   // create_experiment | complete_experiment | disable_experiment | suggestion
  stage     String?  // funnel stage label
  reason    String
  metrics   Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt(sort: Desc)])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String
  serviceId String
  healerId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  healer  Healer  @relation(fields: [healerId], references: [id], onDelete: Cascade)

  @@index([serviceId, createdAt(sort: Desc)])
  @@index([healerId])
  @@index([userId])
}

model QuizLead {
  id             String    @id @default(cuid())
  email          String
  name           String?
  phone          String?
  intention      String    @default("")
  practice       String    @default("")
  chakra         String    @default("")
  productSlug    String?
  productTitle   String?
  score          Int       @default(0)
  email1SentAt   DateTime?
  email2SentAt   DateTime?
  whatsappSentAt          DateTime?
  whatsappFollowupSentAt   DateTime?
  createdAt                DateTime  @default(now())

  @@unique([email, intention, practice, chakra])
  @@index([email])
  @@index([createdAt(sort: Desc)])
  @@index([email1SentAt, email2SentAt])
}

enum Role {
  USER
  HEALER
  ADMIN
}

enum BookingStatus {
  PENDING
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum ServiceMode {
  ONLINE
  OFFLINE
  BOTH
}

enum PaymentType {
  SESSION
  PROGRAM
  MEMBERSHIP
  STORE
  COURSE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum ProgramEnrollmentStatus {
  pending_payment
  active
  completed
  paused
  cancelled
}

enum MembershipInterval {
  MONTHLY
  YEARLY
}

enum MembershipStatus {
  pending
  active
  paused
  cancelled
  halted
}

// ── A/B Testing ──────────────────────────────────────────
model Experiment {
  id          String              @id @default(cuid())
  key         String              @unique
  scope       String?             // e.g. "product_page", "checkout" — only 1 active per scope
  isActive    Boolean             @default(true)
  status      String              @default("active") // draft | active | completed | disabled
  winner      String?             // winning variant name (e.g. "A")
  completedAt DateTime?
  variants    ExperimentVariant[]
  createdAt   DateTime            @default(now())

  @@index([status])
  @@index([scope, isActive])
}

model ExperimentVariant {
  id           String     @id @default(cuid())
  experimentId String
  name         String
  weight       Int        @default(50)
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, name])
  @@index([experimentId])
}

// ── Product Bundles ──────────────────────────────────────
model ProductBundle {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  pricePaise  Int
  chakra      String?
  isActive    Boolean      @default(true)
  items       BundleItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model BundleItem {
  id        String        @id @default(cuid())
  bundleId  String
  productId String
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([productId])
}

// ── Funnel Event Log ─────────────────────────────────────
model FunnelEvent {
  id                String   @id @default(cuid())
  type              String
  userId            String?
  sessionId         String?
  experimentVariant String?
  source            String?
  chakra            String?
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([type])
  @@index([sessionId])
  @@index([createdAt])
  @@index([source])
  @@index([experimentVariant])
  @@index([sessionId, createdAt])  // Composite: session-scoped time queries
  @@index([type, createdAt])       // Composite: type-scoped time queries
}

// ── Daily Funnel Stats (Pre-aggregation) ─────────────────
model DailyFunnelStats {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  quizStart      Int      @default(0)
  quizComplete   Int      @default(0)
  productView    Int      @default(0)
  addToCart      Int      @default(0)
  checkoutStart  Int      @default(0)
  purchase       Int      @default(0)
  totalSessions  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date])
  @@index([date])
}
